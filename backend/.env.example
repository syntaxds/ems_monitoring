PORT=3000
NODE_ENV=production

# Set to true to serve the compiled frontend (/frontend/build) from this server
# as a single-origin deployment. Leave false to host the frontend separately.
SERVE_FRONTEND=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ems_db
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=8h

# MQTT broker (HiveMQ Cloud or any MQTT broker over TLS).
# Auth is username/password over TLS — no client certificates.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USER=
MQTT_PASS=

AI_ENGINE_URL=http://10.244.59.239:5001
AI_API_KEY=
AI_ANOMALY_THRESHOLD=0.75

CORS_ORIGIN=https://your-dashboard-domain.com

UPLOAD_DIR=./uploads/cameras
MAX_IMAGE_SIZE_MB=15

# SMTP — used for password reset emails
SMTP_HOST=mail.pmjsystem.com
SMTP_PORT=587
SMTP_USER=noreply@pmjsystem.com
SMTP_PASS=
SMTP_FROM_NAME=PMJ Fleet Management
FRONTEND_URL=https://fleet.pmjsystem.com
